PIELINE
pipeline {
    agent any

    tools {
        maven 'MAVEN-HOME'
    }

    stages {
        stage('git repo & clean') {
            steps {
                bat "git clone https://github.com/YOUR_USERNAME/metro-reservation.git"
                bat "mvn clean -f metro-reservation/pom.xml"
            }
        }

        stage('install') {
            steps {
                bat "mvn install -f metro-reservation/pom.xml"
            }
        }

        stage('test') {
            steps {
                bat "mvn test -f metro-reservation/pom.xml"
            }
        }

        stage('package') {
            steps {
                bat "mvn package -f metro-reservation/pom.xml"
            }
        }
    }
}


